{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer l'extension (workspace example/)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/example"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "esbuild: build extension"
    }
  ]
}
